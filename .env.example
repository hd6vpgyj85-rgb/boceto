# [MODIFICAR MANUAL] Credenciales de Supabase: copiar este archivo como ".env" y
# completar con los valores de tu propio proyecto (Supabase → Project Settings → API).
# ".env" no se sube al repositorio (ver .gitignore); estas mismas dos variables hay
# que volver a cargarlas en Cloudflare Workers (Settings → Variables and Secrets)
# porque el build en la nube no tiene acceso a tu ".env" local.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
