# Copia este archivo como ".env.local" y completa con los valores de tu propio
# proyecto de Supabase (Project Settings → API). ".env.local" no se sube al
# repositorio (ver .gitignore); estas mismas variables hay que volver a
# cargarlas en Cloudflare Workers (Settings → Variables and Secrets) porque el
# build en la nube no tiene acceso a tu ".env.local" local.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
